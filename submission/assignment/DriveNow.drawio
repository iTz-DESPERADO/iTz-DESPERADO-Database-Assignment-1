        <mxCell id="n33" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="16 | SRS 7.10 | Loyalty accounting" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="220" as="geometry" />
        </mxCell>
        <mxCell id="n34" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Points is positive with Earned/Redeemed type. Balance is earned minus redeemed; tier derives from balance. Confirm expiry and reversal rules." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="265" as="geometry" />
        </mxCell>
        <mxCell id="n35" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="17 | SRS 7.12 | Charged vehicle price" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="380" as="geometry" />
        </mxCell>
        <mxCell id="n36" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Preserve ChargedDailyRate on Rental to support price audit. Confirm pricing for partial days, extensions and mid-rental rate changes." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="425" as="geometry" />
        </mxCell>
        <mxCell id="n37" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="18 | SRS 7.12 | Additional drivers" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="540" as="geometry" />
        </mxCell>
        <mxCell id="n38" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="RentalAdditionalDriver is rental-owned, with local AdditionalDriverNo, name, license number/expiry and daily fee. These identity fields are proposed, not supplied." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="585" as="geometry" />
        </mxCell>
        <mxCell id="n39" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="19 | SRS 7.12 | Conditional participation" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="700" as="geometry" />
        </mxCell>
        <mxCell id="n40" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Main driver is mandatory only for corporate rentals; receiving agent and actual return details become mandatory only on return." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="745" as="geometry" />
        </mxCell>
        <mxCell id="n41" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="20 | SRS 7.12 | Extensions" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="860" as="geometry" />
        </mxCell>
        <mxCell id="n42" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Each rental has at most one predecessor and one direct successor; prevent cycles. Confirm what fields carry over to an extension." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="905" as="geometry" />
        </mxCell>
        <mxCell id="n43" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="21 | SRS 7.4,7.13; 8 | Price audit scope" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="n44" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Keep both dated extra/insurance catalogs and actual charged prices. Finance asks for historical prices; confirm whether catalog history is required even without rentals." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="1065" as="geometry" />
        </mxCell>
        <mxCell id="n45" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="22 | SRS 7.14 | Feedback identity" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="n46" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Feedback belongs to exactly one rental and its customer; no separate submitting-customer link is needed. FeedbackID is a design identifier." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="1225" as="geometry" />
        </mxCell>
        <mxCell id="n47" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="23 | SRS 7.14 | Incoming violations" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1340" as="geometry" />
        </mxCell>
        <mxCell id="n48" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Assume stored violations are matched to a rental. Confirm whether unmatched inbound violations must be retained pending investigation." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="n49" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="24 | SRS 7.15 | Unassigned work" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="n50" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="New job cards may have no assigned mechanic yet. Part and supplier records may exist before supply arrangements. TotalCost is stored; labor pricing is unspecified." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="1545" as="geometry" />
        </mxCell>
        <mxCell id="n51" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="25 | SRS 7.16 | Monthly corporate invoice" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="n52" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Proposed InvoiceNo, BillingMonth and IssuedOn. Each invoice groups at least one rental of one corporate customer; at most one invoice per customer/month." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="1705" as="geometry" />
        </mxCell>
        <mxCell id="n53" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="26 | SRS 7.16 | Invoice membership" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1820" as="geometry" />
        </mxCell>
        <mxCell id="n54" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="A rental belongs to at most one corporate invoice. BilledAmount on INCLUDES_RENTAL supports TotalAmount; adjustments spanning later invoices need clarification." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="1865" as="geometry" />
        </mxCell>
        <mxCell id="n55" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="27 | SRS 7.16 | Payment target" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="1980" as="geometry" />
        </mxCell>
        <mxCell id="n56" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Each Payment targets exactly one Rental OR one CorporateInvoice. This resolves per-rental payments versus monthly corporate billing; allocation across targets is not modeled." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="2025" as="geometry" />
        </mxCell>
        <mxCell id="n57" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="28 | SRS 7.16 | Payment reference" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="2140" as="geometry" />
        </mxCell>
        <mxCell id="n58" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="TransactionReference is mandatory and unique for card/bank payments; absent for cash. PaymentType examples are not assumed to be an exhaustive enumeration." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="2185" as="geometry" />
        </mxCell>
        <mxCell id="n59" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="29 | SRS All | Minimum participation" vertex="1">
          <mxGeometry height="40" width="1840" x="1980" y="2300" as="geometry" />
        </mxCell>
        <mxCell id="n60" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#263A47;fontFamily=Segoe UI;fontSize=22;fontStyle=0;align=left;verticalAlign=middle;spacing=6;strokeWidth=2;" value="Unless required by the text, parent/master records may exist with no related transactions. Every event has its stated required participants." vertex="1">
          <mxGeometry height="105" width="1840" x="1980" y="2345" as="geometry" />
        </mxCell>
      </root>
