urce="m6" target="m14" style="endArrow=classic;endFill=1;startArrow=none;rounded=0;strokeWidth=2;strokeColor=#265F80;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="m16" value="CK: (RentalNo IS NOT NULL AND InvoiceNo IS NULL) OR (RentalNo IS NULL AND InvoiceNo IS NOT NULL)" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=21;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="720" width="3600" height="45" /></mxCell><mxCell id="m17" value="CK: (Method = &amp;#x27;cash&amp;#x27; AND TransactionReference IS NULL) OR (Method IN (&amp;#x27;card&amp;#x27;, &amp;#x27;bank transfer&amp;#x27;) AND TransactionReference IS NOT NULL)" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=21;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="766" width="3600" height="45" /></mxCell></root></mxGraphModel></diagram><diagram id="2-Schema-24" name="2-Schema-24"><mxGraphModel dx="3880" dy="922" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3880" pageHeight="922" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="m1" value="&lt;b&gt;DriveNow | Relational Schema - Corporate Invoices&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=32;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="30" width="3600" height="65" /></mxCell><mxCell id="m2" value="Gamal Khaled Mohamed | Group / ID: G4 | Part B | 2-Schema-24" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=23;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="120" y="105" width="3600" height="50" /></mxCell><mxCell id="m3" value="&lt;b&gt;CORPORATE_INVOICE&lt;/b&gt;" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=25;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="220" width="3500" height="60" /></mxCell><mxCell id="m4" value="&lt;b&gt;&lt;u&gt;Invoice&lt;wbr&gt;No&lt;/u&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;NN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#263A47;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=22;fontColor=#16334A;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="300" width="420" height="190" /></mxCell><mxCell id="m5" value="&lt;b&gt;Corporate&lt;wbr&gt;Customer&lt;wbr&gt;No&lt;/b&gt;&lt;br&gt;&lt;br&gt;NN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#263A47;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=22;fontColor=#16334A;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="300" width="420" height="190" /></mxCell><mxCell id="m6" value="&lt;b&gt;Billing&lt;wbr&gt;Month&lt;/b&gt;&lt;br&gt;&lt;br&gt;NN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#263A47;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=22;fontColor=#16334A;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="980" y="300" width="420" height="190" /></mxCell><mxCell id="m7" value="&lt;b&gt;Issued&lt;wbr&gt;On&lt;/b&gt;&lt;br&gt;&lt;br&gt;NN" style="rounded=0;fillColor=#FFFFFF;strokeColor=#263A47;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=22;fontColor=#16334A;verticalAlign=middle;align=center;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1400" y="300" width="420" height="190" /></mxCell><mxCell id="m8" value="CORPORATE_CUSTOMER.&lt;br&gt;Customer&lt;wbr&gt;No" style="rounded=0;fillColor=#FFFFFF;strokeColor=#263A47;strokeWidth=2;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=20;fontColor=#16334A;verticalAlign=middle;align=center;spacing=8;dashed=1;dashPattern=6 4;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="590" width="420" height="108" /></mxCell><mxCell id="m9" edge="1" parent="1" source="m5" target="m8" style="endArrow=classic;endFill=1;startArrow=none;rounded=0;strokeWidth=2;strokeColor=#265F80;exitX=0.5;exitY=1;exitPerimeter=0;entryX=0.5;entryY=0;entryPerimeter=0;"><mxGeometry as="geometry" relative="1"><Array as="points" /></mxGeometry></mxCell><mxCell id="m10" value="UQ(CorporateCustomerNo, BillingMonth)" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=21;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="720" width="3600" height="45" /></mxCell><mxCell id="m11" value="CK: BillingMonth is the first day of its month" style="text;fillColor=none;strokeColor=none;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=21;fontColor=#16334A;verticalAlign=middle;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="766" width="3600" height="45" /></mxCell></root></mxGraphModel></diagram><diagram id="3-Questions-Assumptions" name="3-Questions-Assumptions"><mxGraphModel grid="0" gridSize="10" page="1" pageScale="1" pageWidth="3880" pageHeight="4350" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="DriveNow | Questions, Assumptions &amp;amp; Contradictions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=34;fontStyle=1;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="30" width="3780" height="65" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="Gamal Khaled Mohamed | Group / ID: G4 | Part C" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="110" width="3780" height="50" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="1. QUESTIONS — pending business clarification" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="200" width="1840" height="60" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="2. ASSUMPTIONS — adopted design decisions" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="200" width="1840" height="60" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="Q01 | SRS 7.1 | Does equal opening and closing time mean a 24-hour branch?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="280" width="1840" height="108" /></mxCell><mxCell id="c6" parent="1" vertex="1" value="Q02 | SRS 7.1 | Must a branch manager be assigned to the branch they manage? Are employee national IDs unique, and are all three name components mandatory?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="398" width="1840" height="108" /></mxCell><mxCell id="c7" parent="1" vertex="1" value="Q03 | SRS 7.2 | May completion date, score and result be recorded separately while an attempt is still in progress?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="516" width="1840" height="108" /></mxCell><mxCell id="c8" parent="1" vertex="1" value="Q04 | SRS 7.3 | Do vehicle-specific prices always override category prices? Can exceptions apply only during specified periods?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="634" width="1840" height="108" /></mxCell><mxCell id="c9" parent="1" vertex="1" value="Q05 | SRS 7.3, 7.6 | Which branch should CurrentBranchCode identify while a vehicle is in transit or rented?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="752" width="1840" height="108" /></mxCell><mxCell id="c10" parent="1" vertex="1" value="Q06 | SRS 7.3 | Should the initial vehicle status create a history entry, and what old status should it have?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="870" width="1840" height="108" /></mxCell><mxCell id="c11" parent="1" vertex="1" value="Q07 | SRS 7.5 | Is current GPS installation sufficient, or is device-swap history required?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="988" width="1840" height="108" /></mxCell><mxCell id="c12" parent="1" vertex="1" value="Q08 | SRS 7.7; 8 | Can one individual account be linked to driver records in several companies?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1106" width="1840" height="108" /></mxCell><mxCell id="c13" parent="1" vertex="1" value="Q09 | SRS 7.7 | What is the uniqueness scope of national IDs, passports and licenses? Is a nationality field required?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1224" width="1840" height="108" /></mxCell><mxCell id="c14" parent="1" vertex="1" value="Q10 | SRS 7.7 | Can a customer be removed from the blacklist? Must reinstatement history be retained?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1342" width="1840" height="108" /></mxCell><mxCell id="c15" parent="1" vertex="1" value="Q11 | SRS 7.8 | Are contract numbers and contract header fields needed beyond dated company/category discounts?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1460" width="1840" height="108" /></mxCell><mxCell id="c16" parent="1" vertex="1" value="Q12 | SRS 7.9 | Do cancelled and no-show reservations consume a promo-code use?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1578" width="1840" height="108" /></mxCell><mxCell id="c17" parent="1" vertex="1" value="Q13 | SRS 7.8-7.10 | Can corporate, promotion and loyalty discounts combine, and in what order?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1696" width="1840" height="108" /></mxCell><mxCell id="c18" parent="1" vertex="1" value="Q14 | SRS 7.10 | How are points earned, redeemed, expired or reversed? May the balance become negative?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1814" width="1840" height="108" /></mxCell><mxCell id="c19" parent="1" vertex="1" value="Q15 | SRS 7.12 | How are partial days, late fees, extensions and rate changes during a rental priced? Which fields carry over to an extension?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="1932" width="1840" height="108" /></mxCell><mxCell id="c20" parent="1" vertex="1" value="Q16 | SRS 7.12 | Which identity fields are required for additional drivers? Is a rental-local driver number acceptable?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2050" width="1840" height="108" /></mxCell><mxCell id="c21" parent="1" vertex="1" value="Q17 | SRS 7.4, 7.13; 8 | Does the price audit require catalog history even when no rentals used a given price?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2168" width="1840" height="108" /></mxCell><mxCell id="c22" parent="1" vertex="1" value="Q18 | SRS 7.14 | Is the feedback comment optional? Should unmatched traffic violations be stored pending investigation?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2286" width="1840" height="108" /></mxCell><mxCell id="c23" parent="1" vertex="1" value="Q19 | SRS 7.15 | May a new job have no assigned mechanics? How is total job cost calculated, including labor?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2404" width="1840" height="108" /></mxCell><mxCell id="c24" parent="1" vertex="1" value="Q20 | SRS 7.16 | Which date assigns a rental to a billing month? How are rentals spanning months and later adjustments billed?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2522" width="1840" height="108" /></mxCell><mxCell id="c25" parent="1" vertex="1" value="Q21 | SRS 7.16 | May one payment cover multiple invoices or rentals? How should refunds and credit notes be represented?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2640" width="1840" height="108" /></mxCell><mxCell id="c26" parent="1" vertex="1" value="Q22 | SRS 11 | Will PostgreSQL or SQL Server be used? Confirm optional UNIQUE behavior before implementation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2758" width="1840" height="108" /></mxCell><mxCell id="c27" parent="1" vertex="1" value="A01 | SRS 7.1 | Inherited identifiers — RentalAgent/Mechanic inherit EmployeeID; Individual/CorporateCustomer inherit CustomerNo. They are not duplicated as new attributes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="280" width="1840" height="100" /></mxCell><mxCell id="c28" parent="1" vertex="1" value="A02 | SRS 7.1 | Opening hours — Use OpeningTime = ClosingTime for a 24-hour branch." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="386" width="1840" height="100" /></mxCell><mxCell id="c29" parent="1" vertex="1" value="A03 | SRS 7.1-7.16 | Design identifiers — Surrogate IDs distinguish models, categories, history events, attempts, feedback, suppliers, discounts and invoices wherever the SRS gives no identifier." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="492" width="1840" height="100" /></mxCell><mxCell id="c30" parent="1" vertex="1" value="A04 | SRS 7.2 | Training in progress — Completion date, score and result may be unknown before completion. Every retake is a separate TrainingAttempt." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="598" width="1840" height="100" /></mxCell><mxCell id="c31" parent="1" vertex="1" value="A05 | SRS 7.3 | Price periods — Use non-overlapping [ValidFrom, ValidTo) periods; an unknown ValidTo means an open end. Category, extra and insurance catalog entries have at least one rate; vehicle-specific rates are optional." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="704" width="1840" height="100" /></mxCell><mxCell id="c32" parent="1" vertex="1" value="A06 | SRS 7.3 | Special vehicle pricing — Vehicle-specific dated rates override category prices when present." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="810" width="1840" height="100" /></mxCell><mxCell id="c33" parent="1" vertex="1" value="A07 | SRS 7.3 | Vehicle location — Current branch is the branch responsible for the current physical placement; this is not real-time coordinates." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="916" width="1840" height="100" /></mxCell><mxCell id="c34" parent="1" vertex="1" value="A08 | SRS 7.3 | Audit completeness — Record old/new status, timestamp and responsible employee for every status change; never rewrite prior events." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1022" width="1840" height="100" /></mxCell><mxCell id="c35" parent="1" vertex="1" value="A09 | SRS 7.5 | GPS installation — Model current one-to-one optional installation with its date. Historical device swaps are not requested." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1128" width="1840" height="100" /></mxCell><mxCell id="c36" parent="1" vertex="1" value="A10 | SRS 7.7 | Optional account link — An authorized-driver record may refer to one individual account; an individual can be authorized by multiple companies." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1234" width="1840" height="100" /></mxCell><mxCell id="c37" parent="1" vertex="1" value="A11 | SRS 7.7 | Individual identity — Store national ID for Egyptians or passport for foreigners." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1340" width="1840" height="100" /></mxCell><mxCell id="c38" parent="1" vertex="1" value="A12 | SRS 7.7 | Blacklist history — Retain blacklist decisions as events; manager status must hold at decision time. Removal/reactivation workflow is unspecified." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1446" width="1840" height="100" /></mxCell><mxCell id="c39" parent="1" vertex="1" value="A13 | SRS 7.8 | Corporate contract scope — Represent the explicitly described dated company/category discounts. No independent contract number or header fields are supplied." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1552" width="1840" height="100" /></mxCell><mxCell id="c40" parent="1" vertex="1" value="A14 | SRS 7.9 | Promo usage count — UsageCount derives from reservations linked to the code." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1658" width="1840" height="100" /></mxCell><mxCell id="c41" parent="1" vertex="1" value="A15 | SRS 7.10 | Loyalty accounting — Points is positive with Earned/Redeemed type. Balance is earned minus redeemed; tier derives from balance." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1764" width="1840" height="100" /></mxCell><mxCell id="c42" parent="1" vertex="1" value="A16 | SRS 7.12 | Charged vehicle price — Preserve ChargedDailyRate on Rental to support price audit." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1870" width="1840" height="100" /></mxCell><mxCell id="c43" parent="1" vertex="1" value="A17 | SRS 7.12 | Additional drivers — RentalAdditionalDriver is rental-owned, with local AdditionalDriverNo, name, license number/expiry and daily fee. Identity fields are proposed assumptions." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="1976" width="1840" height="100" /></mxCell><mxCell id="c44" parent="1" vertex="1" value="A18 | SRS 7.12 | Conditional participation — Main driver is mandatory only for corporate rentals; receiving agent and actual return details become mandatory only on return." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2082" width="1840" height="100" /></mxCell><mxCell id="c45" parent="1" vertex="1" value="A19 | SRS 7.12 | Extensions — Each rental has at most one predecessor and one direct successor; prevent cycles." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2188" width="1840" height="100" /></mxCell><mxCell id="c46" parent="1" vertex="1" value="A20 | SRS 7.4,7.13; 8 | Price audit scope — Keep both dated extra/insurance catalogs and actual charged prices. Finance asks for historical prices; confirm whether catalog history is required even without rentals." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2294" width="1840" height="100" /></mxCell><mxCell id="c47" parent="1" vertex="1" value="A21 | SRS 7.14 | Feedback identity — Feedback belongs to exactly one rental and its customer; no separate submitting-customer link is needed. FeedbackID is a design identifier." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2400" width="1840" height="100" /></mxCell><mxCell id="c48" parent="1" vertex="1" value="A22 | SRS 7.14 | Incoming violations — Assume stored violations are matched to a rental." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2506" width="1840" height="100" /></mxCell><mxCell id="c49" parent="1" vertex="1" value="A23 | SRS 7.15 | Unassigned work — New job cards may have no assigned mechanic yet. Part and supplier records may exist before supply arrangements. TotalCost is stored; labor pricing is unspecified." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2612" width="1840" height="100" /></mxCell><mxCell id="c50" parent="1" vertex="1" value="A24 | SRS 7.16 | Monthly corporate invoice — Proposed InvoiceNo, BillingMonth and IssuedOn. Each invoice groups at least one rental of one corporate customer; at most one invoice per customer/month." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2718" width="1840" height="100" /></mxCell><mxCell id="c51" parent="1" vertex="1" value="A25 | SRS 7.16 | Invoice membership — A rental belongs to at most one corporate invoice. The ERD relationship INCLUDES_RENTAL has BilledAmount; the mapping stores it in RENTAL; later-invoice adjustments are outside this assumed model." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2824" width="1840" height="100" /></mxCell><mxCell id="c52" parent="1" vertex="1" value="A26 | SRS 7.16 | Payment target — Each Payment targets exactly one Rental OR one CorporateInvoice. This resolves per-rental payments versus monthly corporate billing; allocation across targets is not modeled." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="2930" width="1840" height="100" /></mxCell><mxCell id="c53" parent="1" vertex="1" value="A27 | SRS 7.16 | Payment reference — TransactionReference is mandatory and unique for card/bank payments; absent for cash. PaymentType examples are not assumed to be an exhaustive enumeration." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3036" width="1840" height="100" /></mxCell><mxCell id="c54" parent="1" vertex="1" value="A28 | SRS All | Minimum participation — Unless required by the text, parent/master records may exist with no related transactions. Every event has its stated required participants." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3142" width="1840" height="100" /></mxCell><mxCell id="c55" parent="1" vertex="1" value="A29 | SRS 7.1-7.16 | Mapping uses PostgreSQL-style UNIQUE semantics: NULL optional values do not conflict. SQL Server would require filtered unique indexes for those optional references." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3248" width="1840" height="100" /></mxCell><mxCell id="c56" parent="1" vertex="1" value="A30 | SRS 7.1 | National ID uniqueness, mandatory name components, and no self-supervision are adopted integrity assumptions. CompanyEmail is not assumed unique. Hiring age is checked at HireDate, not today." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3354" width="1840" height="100" /></mxCell><mxCell id="c57" parent="1" vertex="1" value="A31 | SRS 7.1-7.16 | Counts are integers; quantities/hours and money use nonnegative or positive domains as drawn. These extra domain checks are design assumptions where the SRS gives no explicit bound. No unstated DEFAULT values are added." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3460" width="1840" height="100" /></mxCell><mxCell id="c58" parent="1" vertex="1" value="A32 | SRS 7.7, 7.9, 7.10, 7.16 | Derived attributes are not stored: PointsBalance = earned minus redeemed (0 without movements); LoyaltyTier derives from balance; UsageCount counts linked reservations; Invoice.TotalAmount sums Rental.BilledAmount." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3566" width="1840" height="100" /></mxCell><mxCell id="c59" parent="1" vertex="1" value="A33 | SRS 7.7 | CustomerPhone is a composite-key table. At least one phone, total/disjoint customer subtypes and disjoint staff subtypes require transaction/application enforcement beyond the drawn column constraints." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3672" width="1840" height="100" /></mxCell><mxCell id="c60" parent="1" vertex="1" value="A34 | SRS 7.12 | Rental main driver is a composite FK to the company-owned driver. MainDriverCorpNo must equal CustomerNo. Presence for corporate customers, absence for individuals, and extension-cycle prevention require cross-row logic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3778" width="1840" height="100" /></mxCell><mxCell id="c61" parent="1" vertex="1" value="A35 | SRS 7.12, 7.16 | InvoiceNo and BilledAmount map the invoice/rental 1:N relationship onto RENTAL. Matching invoice customer/billing month and requiring at least one rental per invoice need cross-row enforcement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3884" width="1840" height="100" /></mxCell><mxCell id="c62" parent="1" vertex="1" value="A36 | SRS 7.3, 7.4, 7.13 | UNIQUE(owner, ValidFrom) avoids duplicate price starts, but cannot prevent overlapping periods. Keeping current catalog prices consistent with history requires transactional logic." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="3990" width="1840" height="100" /></mxCell><mxCell id="c63" parent="1" vertex="1" value="A37 | SRS 7.14-7.16 | Feedback.Comment is assumed optional. Stored violations are matched. Cash has no bank reference; non-cash requires one. A payment targets exactly one rental or invoice." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=22;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="1990" y="4096" width="1840" height="100" /></mxCell><mxCell id="c64" parent="1" vertex="1" value="3. CONTRADICTIONS — review outcome" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="2946" width="1840" height="65" /></mxCell><mxCell id="c65" parent="1" vertex="1" value="No direct contradiction was identified in the reviewed SRS. The following apparent tensions are exceptions or lifecycle clarifications:" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="3026" width="1840" height="95" /></mxCell><mxCell id="c66" parent="1" vertex="1" value="C01 | SRS 7.3 | Category pricing is the general rule; the COO adds vehicle-specific pricing as an exception. These statements are compatible." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="3141" width="1840" height="140" /></mxCell><mxCell id="c67" parent="1" vertex="1" value="C02 | SRS 7.16 | The main text describes rental payments; Finance adds monthly corporate invoicing. These are compatible billing paths, with allocation questions recorded in Q20-Q21." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="3291" width="1840" height="140" /></mxCell><mxCell id="c68" parent="1" vertex="1" value="C03 | SRS 7.12 | Both agents are required on the completed rental, but the receiving agent is unknown at pickup. This is a lifecycle condition, not a contradiction." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;fontSize=24;fontStyle=0;fontColor=#263A47;fillColor=none;strokeColor=none;"><mxGeometry as="geometry" x="50" y="3441" width="1840" height="140" /></mxCell></root></mxGraphModel></diagram><diagram id="4-Business-Rules" name="4-Business-Rules"><mxGraphModel grid="0" gridSize="10" page="1" pageScale="1" pageWidth="3880" pageHeight="1740" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d1" parent="1" vertex="1" value="DriveNow | Business Rules Beyond Constraints" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=36;fontStyle=1;fontColor=#263A47;text;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="40" y="25" width="3800" height="80" /></mxCell><mxCell id="d2" parent="1" vertex="1" value="Gamal Khaled Mohamed | Group / ID: G4 | Part D" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;text;strokeColor=none;fillColor=none;"><mxGeometry as="geometry" x="40" y="110" width="3800" height="65" /></mxCell><mxCell id="d3" parent="1" vertex="1" value="#" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=1;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#EDF3F6;"><mxGeometry as="geometry" x="60" y="220" width="120" height="90" /></mxCell><mxCell id="d4" parent="1" vertex="1" value="SRS section" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=1;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#EDF3F6;"><mxGeometry as="geometry" x="180" y="220" width="280" height="90" /></mxCell><mxCell id="d5" parent="1" vertex="1" value="Business rule" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=1;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#EDF3F6;"><mxGeometry as="geometry" x="460" y="220" width="920" height="90" /></mxCell><mxCell id="d6" parent="1" vertex="1" value="Why constraints are not enough" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=1;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#EDF3F6;"><mxGeometry as="geometry" x="1380" y="220" width="1050" height="90" /></mxCell><mxCell id="d7" parent="1" vertex="1" value="How to enforce it" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=1;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#EDF3F6;"><mxGeometry as="geometry" x="2430" y="220" width="1390" height="90" /></mxCell><mxCell id="d8" parent="1" vertex="1" value="1" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="60" y="310" width="120" height="330" /></mxCell><mxCell id="d9" parent="1" vertex="1" value="7.7" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="180" y="310" width="280" height="330" /></mxCell><mxCell id="d10" parent="1" vertex="1" value="A blacklisted customer cannot make a new reservation." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="460" y="310" width="920" height="330" /></mxCell><mxCell id="d11" parent="1" vertex="1" value="The decision depends on BLACKLIST_ENTRY rows for the customer, not only on values in the new RESERVATION row. An FK confirms that a customer exists; it does not confirm that no blacklist entry exists." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="1380" y="310" width="1050" height="330" /></mxCell><mxCell id="d12" parent="1" vertex="1" value="Use a booking stored procedure that locks the CUSTOMER row, checks for a blacklist entry, then inserts the reservation in the same transaction. Blacklisting must acquire the same customer lock. Restrict direct writes so both operations follow this path. Under the current assumption, blacklist entries have no reinstatement state (Part C, Q10)." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="2430" y="310" width="1390" height="330" /></mxCell><mxCell id="d13" parent="1" vertex="1" value="2" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="60" y="640" width="120" height="330" /></mxCell><mxCell id="d14" parent="1" vertex="1" value="7.9" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="180" y="640" width="280" height="330" /></mxCell><mxCell id="d15" parent="1" vertex="1" value="A promotion cannot be used more than MaximumUses times." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="460" y="640" width="920" height="330" /></mxCell><mxCell id="d16" parent="1" vertex="1" value="This limit compares a count of multiple RESERVATION rows with PROMOTION.MaximumUses. A row CHECK cannot count those uses; concurrent bookings can both see an unused slot." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="1380" y="640" width="1050" height="330" /></mxCell><mxCell id="d17" parent="1" vertex="1" value="In one transaction, lock the PROMOTION row, count reservations linked to the code, reject if the limit is reached, and insert otherwise. Apply the same controlled path to promo assignment changes and limit updates. Count all linked reservations under the current assumption; cancellation/no-show treatment is pending Q12 in Part C." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="2430" y="640" width="1390" height="330" /></mxCell><mxCell id="d18" parent="1" vertex="1" value="3" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="60" y="970" width="120" height="330" /></mxCell><mxCell id="d19" parent="1" vertex="1" value="7.12" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="180" y="970" width="280" height="330" /></mxCell><mxCell id="d20" parent="1" vertex="1" value="A corporate rental must name an authorized driver from that same company; individual rentals use the individual customer as the main driver." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="460" y="970" width="920" height="330" /></mxCell><mxCell id="d21" parent="1" vertex="1" value="The composite FK and same-row company check validate a supplied driver, but do not make that driver mandatory only when CUSTOMER is corporate. This requires reading the customer subtype tables." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="1380" y="970" width="1050" height="330" /></mxCell><mxCell id="d22" parent="1" vertex="1" value="Use a trigger or rental stored procedure to inspect the customer subtype. Require both main-driver fields for corporate customers and neither for individuals. Keep the existing composite FK and company-equality CHECK. Validate rental updates and prevent subtype changes that would invalidate existing rentals within the same transaction." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="2430" y="970" width="1390" height="330" /></mxCell><mxCell id="d23" parent="1" vertex="1" value="4" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="60" y="1300" width="120" height="330" /></mxCell><mxCell id="d24" parent="1" vertex="1" value="7.3; 5 (O-3)" style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="180" y="1300" width="280" height="330" /></mxCell><mxCell id="d25" parent="1" vertex="1" value="Every vehicle status change must record its old status, new status, time and responsible employee." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="460" y="1300" width="920" height="330" /></mxCell><mxCell id="d26" parent="1" vertex="1" value="An FK can validate the employee recorded in an existing event, but cannot require that a VEHICLE update creates a corresponding VEHICLE_STATUS_CHANGE row. A CHECK cannot insert the missing audit record." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="1380" y="1300" width="1050" height="330" /></mxCell><mxCell id="d27" parent="1" vertex="1" value="Use a database trigger on actual CurrentStatus changes to insert old/new status and a database timestamp into VEHICLE_STATUS_CHANGE in the same transaction. Obtain the employee ID from a trusted authenticated session context. Reject unauthenticated changes and deny ordinary users direct updates or deletes on the audit history." style="html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=20;fontFamily=Segoe UI;fontSize=26;fontStyle=0;fontColor=#263A47;rounded=0;strokeColor=#516776;strokeWidth=2;fillColor=#FFFFFF;"><mxGeometry as="geometry" x="2430" y="1300" width="1390" height="330" /></mxCell></root></mxGraphModel></diagram></mxfile>